<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Sharif PVZ PMD Rules"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>دقیقاً مطابق با داکیومنت پروژه</description>

    <!-- شناسایی و حذف کدهای استفاده نشده -->
    <rule ref="category/java/bestpractices.xml/UnusedLocalVariable" />
    <rule ref="category/java/bestpractices.xml/UnusedPrivateField" />
    <rule ref="category/java/bestpractices.xml/UnusedPrivateMethod" />

    <!-- هشدار برای متدهای بسیار طولانی (بیشتر از 50 خط) -->
    <rule ref="category/java/design.xml/ExcessiveMethodLength">
        <properties>
            <property name="minimum" value="50"/>
        </properties>
    </rule>

    <!-- هشدار برای کلاس‌های بسیار طولانی (بیشتر از 500 خط) -->
    <rule ref="category/java/design.xml/ExcessiveClassLength">
        <properties>
            <property name="minimum" value="500"/>
        </properties>
    </rule>

</ruleset>
